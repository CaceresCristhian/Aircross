# ==============================================================================
# AirCross Git & Security Exclusions
# ==============================================================================

# Credentials, API Keys, Tokens, and MCP Configurations
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.cert
*token*
*secret*
*credential*
Copernicus.txt
.netrc
.cdsapirc
.ecmwfapirc
mcp_config.json
*mcp_config*

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
ENV/
.pytest_cache/

# Raw and heavy processed data
data/01_raw/cems/*.csv
data/01_raw/cems/*.zip
data/01_raw/cems/*.parquet
data/01_raw/meteo/*.parquet
data/01_raw/eia860/*.zip
data/02_processed/*.parquet

# Checkpoints and large predictions
experiments/*/checkpoints/
experiments/*/predictions.parquet

# OS and Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
